<nav>
    <a href="/" class="home">HOME</a>

    <!-- Desktop navigation -->
    <div class="links">
        <a href="/projects">PROJECTS</a>
        <a href="/writing">WRITING</a>
        <a href="/learning">LEARNING LOG</a>
        <a href="/about">ABOUT</a>
    </div>

    <!-- Mobile hamburger -->
    <button
        class="menu-button"
        aria-label="Open navigation menu"
        aria-expanded="false"
    >
        <span></span>
        <span></span>
        <span></span>
    </button>
</nav>

<!-- Mobile menu -->
<div class="menu-overlay"></div>

<div class="mobile-menu">
    <button class="close-button" aria-label="Close navigation menu">
        ×
    </button>

    <div class="mobile-links">
        <a href="/">HOME</a>
        <a href="/projects">PROJECTS</a>
        <a href="/writing">WRITING</a>
        <a href="/learning">LEARNING LOG</a>
        <a href="/about">ABOUT</a>
    </div>
</div>

<style>
    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 0rem;
        border-bottom: 1px solid var(--border);
    }

    nav a {
        text-decoration: none;
        color: var(--secondary);
        font-size: 1rem;
        letter-spacing: 0.1em;
        font-weight: 550;
        margin-bottom: 0.5rem;
    }

    nav a:hover {
        text-decoration: underline;
        color: var(--accent);
    }

    .links {
        display: flex;
        gap: 2rem;
    }

    /* Hamburger button */

    .menu-button {
        display: none;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        flex-direction: column;
        gap: 5px;
    }

    .menu-button span {
        display: block;
        width: 28px;
        height: 2px;
        background: var(--secondary);
    }

    /* Mobile drawer */

    .mobile-menu {
        position: fixed;
        top: 0;
        right: -100%;
        width: min(75vw, 320px);
        height: 100vh;

        background: var(--background);
        border-left: 1px solid var(--border);

        z-index: 1000;

        padding: 2rem;

        transition: right 0.3s ease;

        display: flex;
        flex-direction: column;
    }

    .mobile-menu.open {
        right: 0;
    }

    .close-button {
        align-self: flex-end;

        background: none;
        border: none;

        color: var(--secondary);

        font-size: 2rem;
        cursor: pointer;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;

        gap: 2rem;

        margin-top: 4rem;
    }

    .mobile-links a {
        text-decoration: none;

        color: var(--secondary);

        font-size: 1.1rem;
        letter-spacing: 0.1em;
        font-weight: 550;
    }

    /* Background overlay */

    .menu-overlay {
        position: fixed;

        inset: 0;

        background: rgba(0, 0, 0, 0.25);

        opacity: 0;
        visibility: hidden;

        transition:
            opacity 0.3s ease,
            visibility 0.3s ease;

        z-index: 999;
    }

    .menu-overlay.open {
        opacity: 1;
        visibility: visible;
    }


    /* MOBILE */

    @media (max-width: 768px) {

        .links {
            display: none;
        }

        .menu-button {
            display: flex;
        }

        nav {
            padding: 1.25rem 0;
        }

    }

    /* DESKTOP */

    @media (min-width: 769px) {

        .mobile-menu,
        .menu-overlay {
            display: none;
        }

    }
</style>

<script>
    const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
    const mobileMenu = document.querySelector<HTMLDivElement>(".mobile-menu");
    const closeButton = document.querySelector<HTMLButtonElement>(".close-button");
    const overlay = document.querySelector<HTMLDivElement>(".menu-overlay");

    function openMenu() {
        if (!menuButton || !mobileMenu || !overlay) return;

        mobileMenu.classList.add("open");
        overlay.classList.add("open");
        menuButton.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
        if (!menuButton || !mobileMenu || !overlay) return;

        mobileMenu.classList.remove("open");
        overlay.classList.remove("open");
        menuButton.setAttribute("aria-expanded", "false");
    }

    menuButton?.addEventListener("click", openMenu);
    closeButton?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);
</script>