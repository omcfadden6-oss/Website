---
import Layout from "../../layouts/Layouts.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<Layout title="Projects | Olivia McFadden">

    <header class="page-header">

        <p class="eyebrow">PROJECTS</p>

        <h1>My Work</h1>

        <p>
            A collection of technical, scientific and motorsport
            projects exploring data analysis, physics and vehicle performance.
        </p>

    </header>

    {projects.map((project) => (
        <ProjectCard
            number={project.data.number}
            title={project.data.title}
            category={project.data.category}
            description={project.data.description}
            href={`/projects/${project.id}`}
        />
    ))}

</Layout>

<style>
    .page-header {
        padding: 1rem 0 1rem;
        max-width: 900px;
    }

    .eyebrow {
        color: var(--accent);
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: clamp(3rem, 7vw, 6rem);
        line-height: 1;
        letter-spacing: -0.04em;
        margin: 0 0 1.5rem;
    }

    header p:last-child {
        color: var(--secondary);
        font-size: 1.15rem;
        line-height: 1.6;
    }
</style>