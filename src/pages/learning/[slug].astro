---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layouts.astro";

export async function getStaticPaths() {
    const entries = await getCollection("learningLog");

    return entries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Olivia McFadden`}>
    <article>
        <header class="article-header">
            <h1>{entry.data.title}</h1>
            <p class="date">
                {entry.data.date.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                })}
            </p>
            <p class="description">
                {entry.data.description}
            </p>
        </header>
        <div class="article-content">
            <Content />
        </div>
    </article>
</Layout>


<style>
    article {
        margin: 0 auto;
    }

    .article-header {
        padding: 1rem 0 0rem;
    }

    .eyebrow {
        color: var(--accent);
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin: 0 0 1rem;
    }

    .date {
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .description {
        color: var(--secondary);
        font-size: 1.15rem;
        line-height: 1.6;
        max-width: 650px;
    }

    .article-content {
        padding-bottom: 5rem;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--secondary);
    }

    .article-content :global(h1){
        color: var(--text)
    }

    .article-content :global(h2) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border-top: 1px solid var(--border);
        font-size: 2rem;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .article-content :global(h3) {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-size: 1.4rem;
        color: var(--text);
    }
    .article-content :global(strong) {
        color: var(--text);
    }

    .article-content :global(p) {
        margin-bottom: 1.5rem;
    }

    .article-content :global(a) {
        color: var(--accent);
    }

    .article-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .article-content :global(a) {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
    }

    .article-content :global(a:hover) {
        color: var(--accent);
    }
</style>