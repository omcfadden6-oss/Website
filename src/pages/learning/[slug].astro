---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layouts.astro";

export async function getStaticPaths() {
    const entries = await getCollection("learningLog");

    return entries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get all learning log entries
const allEntries = await getCollection("learningLog");

// Sort entries by date, oldest to newest
const sortedEntries = allEntries.sort(
    (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

// Find the current entry
const currentIndex = sortedEntries.findIndex(
    (item) => item.id === entry.id
);

// Find previous and next entries
const previousEntry =
    currentIndex > 0
        ? sortedEntries[currentIndex - 1]
        : null;

const nextEntry =
    currentIndex < sortedEntries.length - 1
        ? sortedEntries[currentIndex + 1]
        : null;
---

<Layout title={`${entry.data.title} | Olivia McFadden`}>
    <article>
        <a href="/learning/" class="back-link">
            ← Back to Learning Log
        </a>
        <header class="article-header">
            <h1>{entry.data.title}</h1>
            <p class="date">
                {entry.data.date.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                })}
            </p>
            <p class="description">
                {entry.data.description}
            </p>
        </header>
        <div class="article-content">
            <Content />
        </div>
        <nav class="week-navigation">
            {previousEntry ? (

                <a
                    href={`/learning/${previousEntry.id}`}
                    class="week-link previous"
                >
                    <span class="nav-label">← Previous Week</span>

                    <span class="nav-title">
                        {previousEntry.data.title}
                    </span>
                </a>

            ) : (

                <div></div>

            )}

            {nextEntry ? (

                <a
                    href={`/learning/${nextEntry.id}`}
                    class="week-link next"
                >
                    <span class="nav-label">Next Week →</span>

                    <span class="nav-title">
                        {nextEntry.data.title}
                    </span>
                </a>

            ) : (

                <div></div>

            )}

        </nav>
    </article>
</Layout>


<style>
    .back-link {
        display: inline-block;
        margin-top: 1rem;
        color: var(--secondary);
        text-decoration: none;
        font-size: 0.95rem;
        transition: opacity 0.2s ease;
    }

    .back-link:hover {
        color: var(--accent);
    }

    article {
        margin: 0 auto;
    }

    .article-header {
        padding: 1rem 0 0rem;
    }

    .eyebrow {
        color: var(--accent);
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin: 0 0 1rem;
    }

    .date {
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .description {
        color: var(--secondary);
        font-size: 1.15rem;
        line-height: 1.6;
        max-width: 650px;
    }

    .article-content {
        padding-bottom: 5rem;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--secondary);
    }

    .article-content :global(h1){
        color: var(--text)
    }

    .article-content :global(h2) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border-top: 1px solid var(--border);
        font-size: 2rem;
        letter-spacing: -0.02em;
        color: var(--text);
    }

    .article-content :global(h3) {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-size: 1.4rem;
        color: var(--text);
    }
    .article-content :global(strong) {
        color: var(--text);
    }

    .article-content :global(p) {
        margin-bottom: 1.5rem;
    }

    .article-content :global(a) {
        color: var(--accent);
    }

    .article-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .article-content :global(a) {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
    }

    .article-content :global(a:hover) {
        color: var(--accent);
    }

    .week-navigation {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;

        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .week-link {
        display: flex;
        flex-direction: column;

        text-decoration: none;
        color: var(--text);

        transition: opacity 0.2s ease;
    }

    .week-link:hover {
        opacity: 0.7;
    }

    .week-link.next {
        text-align: right;
        align-items: flex-end;
    }

    .nav-label {
        color: var(--accent);
        font-size: 0.85rem;

        margin-bottom: 0.4rem;
    }

    .nav-title {
        font-size: 1rem;
        font-weight: 600;
    }
</style>