---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layouts.astro";

export async function getStaticPaths() {
    const posts = await getCollection("writing");

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Olivia McFadden`}>

    <article>
        <a href="/writing/" class="back-link">
            ← Back to Writing
        </a>
        <header class="article-header">
            <h1>{post.data.title}</h1>
            <p class="eyebrow">{post.data.category}</p>
            <p class="date">
                {post.data.date.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                })}
            </p>

            <p class="description">
                {post.data.description}
            </p>

        </header>
        <div class="article-content">
            <Content />
        </div>

    </article>

</Layout>


<style>
    .back-link {
        display: inline-block;
        margin-top: 1rem;
        color: var(--secondary);
        text-decoration: none;
        font-size: 0.95rem;
        transition: opacity 0.2s ease;
    }

    .back-link:hover {
        color: var(--accent);
    }

    article {
        margin: 0 auto;
    }

    .article-header {
        padding: 1rem 0 1rem;
        border-bottom: 1px solid var(--border);
    }

    .eyebrow {
        color: var(--accent);
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin: 0 0 1rem;
    }

    .date {
        color: var(--secondary);
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .description {
        color: var(--secondary);
        font-size: 1.15rem;
        line-height: 1.6;
        max-width: 650px;
    }

    .article-content {
        padding-bottom: 5rem;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--secondary);
    }

    .article-content :global(h1){
        color: var(--text)
    }

    .article-content :global(h2) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        border-top: 1px solid var(--border);
        font-size: 2rem;
        letter-spacing: -0.02em;
        color: var(--text);
        padding-top: 1rem;
    }

    .article-content :global(h3) {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-size: 1.4rem;
        color: var(--text);
    }
    .article-content :global(strong) {
        color: var(--text);
    }

    .article-content :global(p) {
        margin-bottom: 1.5rem;
    }

    .article-content :global(a) {
        color: var(--accent);
    }

    .article-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

</style>